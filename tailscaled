#!/bin/sh
### BEGIN INIT INFO
# Provides:          tailscaled
# Required-Start:    $local_fs $network $syslog
# Required-Stop:     $local_fs $network $syslog
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: tailscaled daemon
# Description:       tailscaled daemon
### END INIT INFO

# iptables(8) and ip(8) install into /usr/local/sbin, which piCore leaves out of
# the default PATH. tailscaled execs them to program netfilter and routes, so
# without this it comes up with no firewall rules and no peer connectivity.
PATH=/usr/local/sbin:/usr/local/bin:$PATH
export PATH

DAEMON=/usr/local/bin/tailscaled
PIDFILE=/var/run/tailscaled.pid

# Keep state on the second partition: tailscaled writes it directly, so the node
# identity survives a reboot whether or not a pCP backup has been taken.
STATEDIR=$(dirname "$(readlink -f /etc/sysconfig/tcedir)")/tailscale_state

test -x $DAEMON || exit 0

case "$1" in
  start)
    echo "Starting tailscaled"
    install -d -m 0700 "$STATEDIR"
    [ -e /var/lib/tailscale ] || ln -s "$STATEDIR" /var/lib/tailscale

    # Kernel mode needs tun plus netfilter. The netfilter modules are tied to the
    # running kernel, so a pCP kernel update can leave them unavailable; drop to
    # userspace networking rather than failing to come up at all.
    if modprobe tun 2>/dev/null && modprobe ip_tables 2>/dev/null; then
        TUN=tailscale0
        # ipv6 is a module here, and tailscaled only pulls it in later via
        # ip6table_mangle. Load it first or net.ipv6.* does not exist yet and
        # IPv6 forwarding silently stays off.
        modprobe ipv6 2>/dev/null
        sysctl -w net.ipv4.ip_forward=1 >/dev/null
        sysctl -w net.ipv6.conf.all.forwarding=1 >/dev/null
    else
        TUN=userspace-networking
        echo "tun/netfilter unavailable, falling back to userspace networking"
    fi

    start-stop-daemon --start --background --pidfile $PIDFILE --make-pidfile \
        --startas $DAEMON -- \
        --statedir="$STATEDIR" --tun=$TUN --no-logs-no-support
    ;;
  stop)
    echo "Stopping tailscaled"
    start-stop-daemon --stop --pidfile $PIDFILE --retry 10
    ;;
  restart)
    "$0" stop
    sleep 2
    "$0" start
    ;;
  *)
    echo "Usage: $0 {start|stop|restart}"
    exit 1
    ;;
esac
exit 0
